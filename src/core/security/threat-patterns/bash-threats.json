{
  "version": "1.0.0",
  "updatedAt": "2026-06-04",
  "description": "Bash 命令安全过滤规则 - 支持热更新，无需重启",
  "blockedPatterns": [
    { "pattern": "\\brm\\s+(-[a-zA-Z]*f[a-zA-Z]*\\s+)?(-[a-zA-Z]*r[a-zA-Z]*\\s+)?\\/\\s*$", "reason": "禁止删除根目录", "severity": "critical" },
    { "pattern": "\\brm\\s+(-[a-zA-Z]*r[a-zA-Z]*\\s+)?(-[a-zA-Z]*f[a-zA-Z]*\\s+)?\\/\\s*$", "reason": "禁止删除根目录", "severity": "critical" },
    { "pattern": "\\brm\\s+-rf\\s+\\/[a-zA-Z]", "reason": "禁止递归强制删除系统目录", "severity": "critical" },
    { "pattern": "\\bdel\\s+\\/[sfq]\\s+[Cc]:\\\\", "reason": "禁止 Windows 强制删除", "severity": "critical" },
    { "pattern": "\\bformat\\s+[a-zA-Z]:", "reason": "禁止格式化磁盘", "severity": "critical" },
    { "pattern": "\\brd\\s+\\/[sfq]", "reason": "禁止 Windows 递归删除目录", "severity": "critical" },
    { "pattern": "\\bRemove-Item\\s+.*-Recurse.*-Force.*[Cc]:\\\\", "reason": "禁止 PowerShell 递归强制删除", "severity": "critical" },
    { "pattern": "\\bcurl\\s+.*\\|\\s*(bash|sh|zsh|fish)", "reason": "禁止远程脚本执行（curl | bash）", "severity": "critical" },
    { "pattern": "\\bwget\\s+.*\\|\\s*(bash|sh|zsh|fish)", "reason": "禁止远程脚本执行（wget | bash）", "severity": "critical" },
    { "pattern": "\\bcurl\\s+.*\\|\\s*python", "reason": "禁止远程脚本执行（curl | python）", "severity": "critical" },
    { "pattern": "\\bwget\\s+.*-O\\s+.*\\|\\s*(bash|sh)", "reason": "禁止远程脚本执行", "severity": "critical" },
    { "pattern": "\\bsudo\\s+", "reason": "禁止 sudo 权限提升", "severity": "high" },
    { "pattern": "\\bsu\\s+", "reason": "禁止 su 切换用户", "severity": "high" },
    { "pattern": "\\brunas\\s+", "reason": "禁止 Windows runas 提权", "severity": "high" },
    { "pattern": "\\bStart-Process\\s+.*-Verb\\s+RunAs", "reason": "禁止 PowerShell 管理员提权", "severity": "high" },
    { "pattern": "\\bnc\\s+.*-[lLe]", "reason": "禁止 netcat 监听模式（可能创建后门）", "severity": "high" },
    { "pattern": "\\bncat\\s+.*-[lLe]", "reason": "禁止 ncat 监听模式", "severity": "high" },
    { "pattern": "\\bpython[23]?\\s+-m\\s+http\\.server", "reason": "禁止启动 HTTP 服务器", "severity": "medium" },
    { "pattern": "\\bpython[23]?\\s+-m\\s+SimpleHTTPServer", "reason": "禁止启动 HTTP 服务器", "severity": "medium" },
    { "pattern": "\\bruby\\s+-run\\s+-e", "reason": "禁止 Ruby HTTP 服务器", "severity": "medium" },
    { "pattern": "\\bphp\\s+-S\\s+", "reason": "禁止 PHP 内置服务器", "severity": "medium" },
    { "pattern": "\\/etc\\/(passwd|shadow|sudoers)", "reason": "禁止访问系统敏感文件", "severity": "high" },
    { "pattern": "\\~\\/\\.ssh\\/", "reason": "禁止访问 SSH 密钥目录", "severity": "high" },
    { "pattern": "\\~\\/\\.gnupg\\/", "reason": "禁止访问 GPG 密钥目录", "severity": "high" },
    { "pattern": "\\bcat\\s+.*\\/\\.env\\b", "reason": "禁止读取 .env 文件", "severity": "medium" },
    { "pattern": "\\bsystemctl\\s+(stop|disable|mask)\\s+", "reason": "禁止停止/禁用系统服务", "severity": "high" },
    { "pattern": "\\bservice\\s+\\w+\\s+stop", "reason": "禁止停止系统服务", "severity": "high" },
    { "pattern": "\\bnet\\s+(stop|start)\\s+", "reason": "禁止操控 Windows 服务", "severity": "high" },
    { "pattern": "\\bshutdown\\b", "reason": "禁止关机命令", "severity": "critical" },
    { "pattern": "\\breboot\\b", "reason": "禁止重启命令", "severity": "critical" },
    { "pattern": "\\bmodprobe\\b", "reason": "禁止加载内核模块", "severity": "high" },
    { "pattern": "\\binsmod\\b", "reason": "禁止插入内核模块", "severity": "high" },
    { "pattern": "\\brmmod\\b", "reason": "禁止移除内核模块", "severity": "high" },
    { "pattern": "\\bdd\\s+.*of=\\/dev\\/", "reason": "禁止直接写入块设备", "severity": "critical" },
    { "pattern": "\\bmkfs\\.", "reason": "禁止格式化文件系统", "severity": "critical" },
    { "pattern": "\\bfdisk\\b", "reason": "禁止磁盘分区操作", "severity": "critical" },
    { "pattern": "\\bcrontab\\s+", "reason": "禁止修改 crontab（可能植入后门）", "severity": "medium" },
    { "pattern": "\\bschtasks\\s+.*\\/create", "reason": "禁止创建 Windows 计划任务", "severity": "medium" }
  ],
  "warnPatterns": [
    { "pattern": "\\bgit\\s+push\\s+--force", "reason": "强制推送可能覆盖远程提交", "severity": "medium" },
    { "pattern": "\\bgit\\s+reset\\s+--hard", "reason": "硬重置会丢失未提交的更改", "severity": "medium" },
    { "pattern": "\\bgit\\s+clean\\s+-[fd]", "reason": "清理会删除未跟踪的文件", "severity": "medium" },
    { "pattern": "\\bnpm\\s+publish", "reason": "发布到 npm 仓库", "severity": "medium" },
    { "pattern": "\\bdocker\\s+(rm|rmi)\\s+", "reason": "删除 Docker 容器/镜像", "severity": "low" },
    { "pattern": "\\bkill\\s+-9", "reason": "强制终止进程", "severity": "low" }
  ]
}
