{
  "version": "1.0.0",
  "updatedAt": "2026-06-04",
  "description": "提示注入检测规则 - 支持热更新，无需重启",
  "injectionPatterns": [
    {
      "category": "role_override",
      "severity": "high",
      "patterns": [
        { "regex": "ignore\\s+(all\\s+)?(previous|above|prior)\\s+(instructions?|prompts?|rules?)", "description": "忽略之前的指令" },
        { "regex": "disregard\\s+(all\\s+)?(previous|above)\\s+(instructions?|prompts?)", "description": "忽略之前的指令" },
        { "regex": "forget\\s+(all\\s+)?(previous|above|your)\\s+(instructions?|prompts?|training)", "description": "忘记之前的指令" },
        { "regex": "you\\s+are\\s+now\\s+(a|an)\\s+\\w+", "description": "角色覆盖尝试" },
        { "regex": "act\\s+as\\s+(if\\s+you\\s+are|a|an)\\s+\\w+", "description": "角色扮演尝试" },
        { "regex": "pretend\\s+(to\\s+be|that\\s+you\\s+are)", "description": "伪装尝试" },
        { "regex": "simulate\\s+(being|a|an)\\s+\\w+", "description": "模拟尝试" }
      ]
    },
    {
      "category": "instruction_injection",
      "severity": "critical",
      "patterns": [
        { "regex": "\\[system\\]", "description": "系统标签注入" },
        { "regex": "\\[instruction\\]", "description": "指令标签注入" },
        { "regex": "\\[admin\\]", "description": "管理员标签注入" },
        { "regex": "\\[developer\\]", "description": "开发者标签注入" },
        { "regex": "<<<.*>>>", "description": "特殊分隔符注入" },
        { "regex": "\\{\\{.*\\}\\}", "description": "模板注入" },
        { "regex": "<\\|.*\\|>", "description": "特殊标记注入" }
      ]
    },
    {
      "category": "output_manipulation",
      "severity": "high",
      "patterns": [
        { "regex": "print\\s+[\"'].*[\"']", "description": "强制输出尝试" },
        { "regex": "output\\s+the\\s+(following|text)", "description": "输出操纵" },
        { "regex": "repeat\\s+(after\\s+me|the\\s+following)", "description": "重复攻击" },
        { "regex": "say\\s+[\"'].*[\"']", "description": "强制说话" },
        { "regex": "respond\\s+with\\s+only", "description": "限制响应" }
      ]
    },
    {
      "category": "data_exfiltration",
      "severity": "high",
      "patterns": [
        { "regex": "reveal\\s+(your|the)\\s+(system\\s+)?prompt", "description": "提示泄露尝试" },
        { "regex": "show\\s+(me\\s+)?(your|the)\\s+(system\\s+)?prompt", "description": "提示泄露尝试" },
        { "regex": "what\\s+(is|are)\\s+(your|the)\\s+(system\\s+)?instructions?", "description": "指令探查" },
        { "regex": "dump\\s+(your|the)\\s+(memory|context|prompt)", "description": "内存转储尝试" },
        { "regex": "export\\s+(all\\s+)?(your|the)\\s+(data|memory|knowledge)", "description": "数据导出尝试" }
      ]
    },
    {
      "category": "command_injection",
      "severity": "critical",
      "patterns": [
        { "regex": "execute\\s+(the\\s+)?following\\s+command", "description": "命令执行尝试" },
        { "regex": "run\\s+(the\\s+)?following\\s+(code|script|command)", "description": "代码执行尝试" },
        { "regex": "eval\\s*\\(", "description": "Eval 注入" },
        { "regex": "exec\\s*\\(", "description": "Exec 注入" },
        { "regex": "`[^`]+`", "description": "代码块注入" },
        { "regex": "```[\\s\\S]*?```", "description": "多行代码块" }
      ]
    },
    {
      "category": "social_engineering",
      "severity": "medium",
      "patterns": [
        { "regex": "this\\s+is\\s+(a\\s+)?test", "description": "测试借口" },
        { "regex": "i\\s+am\\s+(your\\s+)?(developer|admin|creator)", "description": "身份伪造" },
        { "regex": "emergency\\s+(mode|override)", "description": "紧急模式借口" },
        { "regex": "debug\\s+mode", "description": "调试模式借口" },
        { "regex": "maintenance\\s+mode", "description": "维护模式借口" }
      ]
    },
    {
      "category": "encoding_evasion",
      "severity": "medium",
      "patterns": [
        { "regex": "\\\\u[0-9a-f]{4}", "description": "Unicode 编码" },
        { "regex": "\\\\x[0-9a-f]{2}", "description": "十六进制编码" },
        { "regex": "[a-zA-Z0-9+/]{20,}={0,2}", "description": "可能的 Base64 编码" },
        { "regex": "&#x?[0-9a-f]+;", "description": "HTML 实体编码" }
      ]
    },
    {
      "category": "delimiter_injection",
      "severity": "high",
      "patterns": [
        { "regex": "---+\\s*system\\s*---+", "description": "系统分隔符注入" },
        { "regex": "===+\\s*instruction\\s*===+", "description": "指令分隔符注入" },
        { "regex": "\\*\\*\\*+\\s*new\\s+prompt\\s*\\*\\*\\*+", "description": "新提示分隔符" },
        { "regex": "###\\s*(system|instruction|admin)", "description": "Markdown 标题注入" }
      ]
    },
    {
      "category": "chinese_role_override",
      "severity": "high",
      "patterns": [
        { "regex": "忽略(之前|以上|上面|前面|所有)?(的)?(指令|提示|规则|设定)", "description": "中文忽略指令" },
        { "regex": "忘记(之前|以上|你的)?(的)?(指令|提示|训练|设定)", "description": "中文忘记指令" },
        { "regex": "你现在是(一个|一名)?", "description": "中文角色覆盖" },
        { "regex": "假装你是", "description": "中文伪装尝试" },
        { "regex": "扮演(一个|一名)?", "description": "中文角色扮演" },
        { "regex": "模拟(成为|一个|一名)?", "description": "中文模拟尝试" }
      ]
    },
    {
      "category": "chinese_instruction_injection",
      "severity": "critical",
      "patterns": [
        { "regex": "【系统】", "description": "中文系统标签注入" },
        { "regex": "【指令】", "description": "中文指令标签注入" },
        { "regex": "【管理员】", "description": "中文管理员标签注入" },
        { "regex": "【开发者】", "description": "中文开发者标签注入" },
        { "regex": "执行以下(命令|代码|脚本)", "description": "中文命令执行" },
        { "regex": "运行以下(命令|代码|脚本)", "description": "中文代码执行" }
      ]
    },
    {
      "category": "chinese_data_exfiltration",
      "severity": "high",
      "patterns": [
        { "regex": "显示(你的|系统)(提示|指令|设定)", "description": "中文提示泄露" },
        { "regex": "泄露(你的|系统)(提示|指令)", "description": "中文提示泄露" },
        { "regex": "导出(所有)?(数据|记忆|知识)", "description": "中文数据导出" },
        { "regex": "转储(你的|系统)(内存|上下文)", "description": "中文内存转储" }
      ]
    },
    {
      "category": "chinese_social_engineering",
      "severity": "medium",
      "patterns": [
        { "regex": "我是(你的)?(开发者|管理员|创建者)", "description": "中文身份伪造" },
        { "regex": "紧急模式", "description": "中文紧急模式" },
        { "regex": "调试模式", "description": "中文调试模式" },
        { "regex": "维护模式", "description": "中文维护模式" },
        { "regex": "这是(一个)?测试", "description": "中文测试借口" }
      ]
    }
  ],
  "contextPatterns": [
    {
      "context": "file_path",
      "patterns": ["\\.\\./", "\\.\\.\\\\", "~/", "/etc/", "/root/"]
    },
    {
      "context": "url",
      "patterns": ["javascript:", "data:", "vbscript:"]
    }
  ]
}
