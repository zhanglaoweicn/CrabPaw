# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Batch files — Windows CRLF required
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts — LF required
*.sh text eol=lf

# Source code — LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.webp binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.exe binary
*.dll binary
*.pak binary
*.asar binary
