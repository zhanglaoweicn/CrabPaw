# ============================================================
# CrabPaw v2.2.0 — 环境变量配置
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================================

# ── 必需：AI 模型配置（至少配置一个 provider）───────────────
# DeepSeek（推荐，便宜好用）
DEEPSEEK_API_KEY=your-key-here
# 通义千问（备选）
QWEN_API_KEY=your-key-here

# ── 可选：飞书/Lark 集成 ────────────────────────────────────
LARK_APP_ID=cli_xxxxxxxx
LARK_APP_SECRET=xxxxxxxx

# ── 可选：企业微信集成 ──────────────────────────────────────
WECOM_CORP_ID=your-key-here
WECOM_AGENT_SECRET=your-key-here

# ── 可选：AI 服务配置 ───────────────────────────────────────
# AI_PROVIDER=deepseek          # 默认模型提供商 (deepseek|qwen|openai|anthropic)
# AI_MODEL=deepseek-chat        # 默认模型
# AI_MAX_TOKENS=4000            # 最大输出 token 数
# AI_TEMPERATURE=0.7            # 温度参数

# ── 可选：服务端口 ──────────────────────────────────────────
# PORT=38767                    # HTTP/API 服务端口（默认 38767）

# ── 可选：数据目录 ──────────────────────────────────────────
# CRABPAW_DATA_DIR=./data/.crabpaw   # 数据存储目录（默认 <项目>/data/.crabpaw；桌面端自动指向 CrabPaw-Data）
# CRABPAW_HOME=~/.crabpaw            # 辅助状态目录（workflows/hooks/profiles/secrets 等，桌面端自动随数据目录）

# ── 可选：日志级别 ──────────────────────────────────────────
# LOG_LEVEL=info                # debug | info | warn | error

# ── 可选：禁用遥测 ──────────────────────────────────────────
# DISABLE_TELEMETRY=1
